# Copy this file to `.env` and fill in real values from your Supabase project.
# All client-visible vars MUST be prefixed with EXPO_PUBLIC_ (Expo inlines these at build time).
# The anon key is safe to ship in the client; Row Level Security is what protects data.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Google OAuth web client id (used by Supabase Auth Google provider / native sign-in).
# Configure the provider in Supabase Dashboard > Authentication > Providers > Google.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# EAS project id, set after `eas init`. Required for Expo push tokens on a dev/standalone build.
EXPO_PUBLIC_EAS_PROJECT_ID=
