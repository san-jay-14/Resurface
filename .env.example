# Copy this file to `.env` (or `.env.local`) and fill in real values.
# All client-visible vars MUST be prefixed with EXPO_PUBLIC_ (Expo inlines these at build time).
# Server-side keys live in server/.env.example, never here.

# Base URL of the Resurface API (see DEPLOY.md). No trailing slash.
#   Android emulator + local server: http://10.0.2.2:8787
#   Deployed: https://<your-service>.onrender.com
EXPO_PUBLIC_API_URL=http://10.0.2.2:8787

# Google OAuth WEB client id. Native Google sign-in obtains an ID token for this audience and the API
# verifies it (set the same value as GOOGLE_CLIENT_ID on the server).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# EAS project id, set after `eas init`. Required for Expo push tokens on a dev/standalone build.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Mapbox public token, required for the Places map view.
# Get yours at https://console.mapbox.com/account/access-tokens/
EXPO_PUBLIC_MAPBOX_TOKEN=
