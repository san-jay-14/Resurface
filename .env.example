# Copy this file to `.env` and fill in real values from your Supabase project.
# All client-visible vars MUST be prefixed with EXPO_PUBLIC_ (Expo inlines these at build time).
# The anon key is safe to ship in the client; Row Level Security is what protects data.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Google OAuth web client id (used by Supabase Auth Google provider / native sign-in).
# Configure the provider in Supabase Dashboard > Authentication > Providers > Google.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# EAS project id, set after `eas init`. Required for Expo push tokens on a dev/standalone build.
EXPO_PUBLIC_EAS_PROJECT_ID=

# ---------------------------------------------------------------------------
# Server-side keys — set these in Supabase Dashboard > Edge Functions > Secrets
# (never prefix with EXPO_PUBLIC_; these must not ship in the client bundle)
# ---------------------------------------------------------------------------

# Anthropic API key for Claude classification in the enrich-save Edge Function.
# Required for the auto save path (web + YouTube URLs).
# ANTHROPIC_API_KEY=sk-ant-...

# YouTube Data API v3 key — enables rich metadata for YouTube/Shorts saves.
# Without this, YouTube saves are classified from the URL alone.
# Enable at: console.cloud.google.com > APIs & Services > YouTube Data API v3
# YOUTUBE_API_KEY=AIza...

# Google Geocoding API key — geocodes location_hints extracted by Claude.
# Without this, Places saves won't have lat/lng. Requires a billing account.
# Enable at: console.cloud.google.com > APIs & Services > Geocoding API
# GOOGLE_GEOCODING_API_KEY=AIza...
