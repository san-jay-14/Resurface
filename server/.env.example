# Copy to server/.env for local development (`npm run dev`). In production set these in the host's
# dashboard (see ../DEPLOY.md). Never commit real values.

NODE_ENV=development
PORT=8787
LOG_LEVEL=info

# ---- Database (Neon) -------------------------------------------------------------------------
# DATABASE_URL: the POOLED connection string (host contains "-pooler"), used by the app.
# DATABASE_URL_DIRECT: the DIRECT string, used only for migrations (they need session-level locks).
DATABASE_URL=
DATABASE_URL_DIRECT=
DB_POOL_MAX=5
MIGRATE_ON_BOOT=true

# ---- Auth (Better Auth) ----------------------------------------------------------------------
# openssl rand -base64 48
BETTER_AUTH_SECRET=
# Public base URL of this API, e.g. https://dibs-api.onrender.com (http://localhost:8787 locally)
PUBLIC_URL=http://localhost:8787
APP_SCHEMES=resurface,dibs
# Native sign-in: the WEB client id from Google Cloud (same as EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID).
GOOGLE_CLIENT_ID=
# Apple: iOS bundle id (native id-token flow).
APPLE_CLIENT_ID=
APPLE_APP_BUNDLE_ID=com.resurface.app

# ---- Service-to-service ----------------------------------------------------------------------
# Secret that cron-job.org sends as `Authorization: Bearer <TICK_SECRET>` to POST /internal/tick.
TICK_SECRET=
# Token for the admin dashboard at /admin (x-admin-token header). Min 24 chars.
ADMIN_DASHBOARD_TOKEN=

# ---- Object storage (Cloudflare R2) ----------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public URL prefix of the bucket (custom domain or the r2.dev URL), no trailing slash.
R2_PUBLIC_BASE_URL=

# ---- Providers (usage-billed; leave blank to disable that capability) -------------------------
ANTHROPIC_API_KEY=
HIKERAPI_KEY=
YOUTUBE_API_KEY=
GOOGLE_PLACES_API_KEY=
# Alerts (breaker opened, dead jobs): Slack/Discord-compatible incoming webhook.
ALERT_WEBHOOK_URL=
# Only if "enhanced push security" is enabled for your Expo project.
EXPO_ACCESS_TOKEN=

# ---- Daily spend caps per provider (USD; YouTube in quota units) ------------------------------
BUDGET_HIKERAPI=5
BUDGET_ANTHROPIC=5
BUDGET_GOOGLE_PLACES=5
BUDGET_YOUTUBE_DATA_API=9000

# ---- Optional --------------------------------------------------------------------------------
# Video rung of the frames ladder; needs ffmpeg on PATH (not in the free-tier image).
FFMPEG_ENABLED=false
